---
import BlackHole from './BlackHole.astro';
import { blackHole, profile } from '../data/site';
---

<section class="hero" id="top">
  <BlackHole />
  <div class="hero-content wrap">
    <p class="eyebrow display">{profile.role}</p>
    <h1 class="display">{profile.name}</h1>
    <p class="motto">{blackHole.singularity.title}</p>
    <p class="lede">{blackHole.singularity.description}</p>
  </div>
  <div class="hero-controls wrap">
    <p class="visualisation-caption">
      <span>{blackHole.note}</span>
      <a href={blackHole.credit.url} target="_blank" rel="noopener noreferrer">{blackHole.credit.label}</a>
    </p>
    <button type="button" class="pill" data-bh-toggle aria-pressed="false" hidden>Pause</button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(680px, 100svh);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
  }
  .hero-content {
    position: relative;
    width: 100%;
    padding-bottom: 1.1rem;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.7rem;
    color: var(--accent);
  }
  .eyebrow::before {
    content: '';
    width: 1.6rem;
    height: 1px;
    background: var(--accent);
  }
  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2rem, 4.1vw, 3.65rem);
    letter-spacing: 0.06em;
    line-height: 1.08;
    text-wrap: balance;
    max-width: 11ch;
  }
  .motto {
    margin-top: 1.4rem;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.4;
    color: var(--ink);
  }
  .lede {
    margin-top: 0.55rem;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }
  .hero-controls {
    position: relative;
    width: 100%;
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .visualisation-caption {
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .hero-controls .pill { flex-shrink: 0; }
  /* Reserve the control's space while graphics initialize, keeping the motto still. */
  .hero-controls .pill[hidden] { display: inline-flex; visibility: hidden; }
  .visualisation-caption a {
    margin-left: 0.35em;
    text-decoration-color: var(--hair);
  }
  @media (max-width: 860px) {
    .eyebrow { font-size: 0.6rem; letter-spacing: 0.1em; }
    .hero-controls { padding-bottom: 1.5rem; gap: 1rem; }
    h1 { font-size: clamp(1.65rem, 8vw, 3.2rem); }
  }
  @media (min-width: 560px) and (max-width: 860px) {
    .hero { min-height: max(820px, 100svh); }
  }
</style>
