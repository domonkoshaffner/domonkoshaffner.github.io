---
/**
 * Still star field fixed behind the page, so the sections below the hero stay
 * in space. Drawn once per resize; no animation.
 */
---

<canvas class="starfield" data-starfield aria-hidden="true"></canvas>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    function hash(n: number) {
      const x = Math.sin(n * 12.9898 + 78.233) * 43758.5453;
      return x - Math.floor(x);
    }
    function draw() {
      if (!ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = window.innerWidth, h = window.innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const count = Math.round((w * h) / 4200);
      for (let i = 0; i < count; i++) {
        const x = hash(i * 3 + 1) * w;
        const y = hash(i * 3 + 2) * h;
        const s = hash(i * 3 + 3);
        const r = s < 0.85 ? 0.6 : s < 0.97 ? 1.0 : 1.5;
        const a = 0.18 + 0.5 * hash(i * 7 + 5);
        const warm = hash(i * 11 + 9) > 0.7;
        ctx.fillStyle = warm ? `rgba(255, 228, 190, ${a})` : `rgba(200, 216, 245, ${a})`;
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    draw();
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = setTimeout(draw, 120) as unknown as number; });
  }
</script>
