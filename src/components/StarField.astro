---
/**
 * Still star field fixed behind the page, so the sections below the hero stay
 * in space. Drawn once per size; no animation.
 *
 * The layer is as tall as the viewport can get (`lvh`), not as tall as it is
 * right now. On phones the address bar slides away on the first scroll down;
 * a layer sized to the current viewport is stretched frame by frame while that
 * happens and then redrawn, which makes the stars slide and pop.
 *
 * Some phone browsers (Chrome on iOS) resize the page with their toolbars, so
 * even `lvh` changes during a scroll. Two things keep the stars still there:
 * the layer never gets shorter at a given width, and stars are placed band by
 * band from the top, so extra height only adds sky underneath.
 */
---

<canvas class="starfield" data-starfield aria-hidden="true"></canvas>

<style>
  .starfield {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    function hash(n: number) {
      const x = Math.sin(n * 12.9898 + 78.233) * 43758.5453;
      return x - Math.floor(x);
    }
    const BAND = 240;
    let drawn = '';
    function draw() {
      if (!ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      // Measure the layer, not the window: its size ignores the address bar.
      const w = canvas.clientWidth, h = canvas.clientHeight;
      const size = `${w}:${h}:${dpr}`;
      if (!w || !h || size === drawn) return;
      drawn = size;
      // Hold this height until the width changes, so toolbars that come back
      // do not shrink the layer and start another round of redraws.
      canvas.style.minHeight = `${h}px`;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      // One star per 4200 px², placed band by band: a star's position depends
      // on its band and the width, never on how tall the layer is.
      const perBand = Math.round((w * BAND) / 4200);
      for (let band = 0; band * BAND < h; band++) {
        for (let j = 0; j < perBand; j++) {
          const i = band * 1009 + j;
          const x = hash(i * 3 + 1) * w;
          const y = (band + hash(i * 3 + 2)) * BAND;
          const s = hash(i * 3 + 3);
          const r = s < 0.85 ? 0.6 : s < 0.97 ? 1.0 : 1.5;
          const a = 0.18 + 0.5 * hash(i * 7 + 5);
          const warm = hash(i * 11 + 9) > 0.7;
          ctx.fillStyle = warm ? `rgba(255, 228, 190, ${a})` : `rgba(200, 216, 245, ${a})`;
          ctx.beginPath();
          ctx.arc(x, y, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }
    // Runs once the layer has its styled size and whenever that size changes,
    // before the next paint, so the stars are never shown stretched. The script
    // can start before the stylesheet applies, so there is no draw at startup.
    new ResizeObserver(draw).observe(canvas);
    // A new width (rotation, window resize) lets the layer take its natural height again.
    let width = innerWidth;
    addEventListener('resize', () => {
      if (innerWidth === width) return;
      width = innerWidth;
      canvas.style.minHeight = '';
    });
  }
</script>
