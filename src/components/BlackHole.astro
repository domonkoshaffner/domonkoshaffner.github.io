---
/** Retina-resolution WebGL scene: cached gravitational paths, animated plasma. */
---

<div class="bh" data-blackhole>
  <canvas data-bh-canvas aria-hidden="true"></canvas>
  <div class="bh-fallback" aria-hidden="true"></div>
</div>
<script is:inline>
  // The scene opens dark and assembles its disk, so while it loads nothing lit
  // may show. Marked before the first paint; without scripts the still picture
  // stays. If the renderer never arrives, the picture comes back.
  (() => {
    const hole = document.currentScript.previousElementSibling;
    hole.classList.add('is-loading');
    setTimeout(() => { if (!hole.classList.contains('is-ready')) hole.classList.remove('is-loading'); }, 8000);
  })();
</script>

<style>
  .bh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Reveal the same still sky as the rest of the page outside the lens.
       The composite shader mirrors this gradient (pageFade) to keep the halo
       under the ring even: change the two together. */
    mask-image: linear-gradient(to bottom, #000 65%, rgba(0, 0, 0, 0.58) 84%, transparent 100%);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* The sky fades in under the opening instead of appearing at once. Kept
       short: the scene cannot be in the first paint (the graphics card needs
       about a tenth of a second to compile it), so it should not linger. */
    opacity: 0;
    transition: opacity 0.25s ease-out;
  }
  .bh.is-ready canvas { opacity: 1; }
  /* A complete still image without JS, or if WebGL is unavailable. While the
     renderer loads the page's own stars show instead. */
  .bh-fallback {
    position: absolute;
    inset: 0;
    background: var(--space);
  }
  .bh-fallback::before {
    content: '';
    position: absolute;
    left: 72%;
    top: 45%;
    width: min(74vh, 65vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle,
      #000 0 18%, #bfe3ff 18.5%, #507fbe 19.5%, #131e2c 21%,
      #ffda85 24%, #ef9a35 27%, #763110 31%, #d76a1c 33%,
      #4b1b08 38%, #9d4514 40%, rgba(128, 48, 8, 0.4) 48%, transparent 65%);
  }
  @media (max-width: 860px) {
    .bh-fallback::before { left: 50%; top: 34%; width: min(90vw, 65vh); }
  }
  .bh.is-ready .bh-fallback, .bh.is-loading .bh-fallback { display: none; }
  .bh.is-fallback canvas { display: none; }
  .bh.is-fallback .bh-fallback { display: block; }
</style>

<script>
  import { startBlackHole } from '../lib/blackHoleRenderer';
  const root = document.querySelector<HTMLElement>('[data-blackhole]');
  if (root) {
    const dispose = startBlackHole(root);
    import.meta.hot?.dispose(dispose);
  }
</script>
