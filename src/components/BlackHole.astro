---
/**
 * The black hole. Raw WebGL, no dependencies.
 *
 * A fragment shader marches each pixel's light ray backwards through a
 * Schwarzschild-like gravitational field (pseudo-Newtonian geodesics), records
 * crossings of a thin rotating accretion disk with Doppler beaming, and ends
 * on a procedural star field, so the stars behind the hole are lensed too.
 * Renders at a capped internal resolution, adapts quality to frame time, and
 * pauses when off-screen, hidden, or asked to.
 */
---

<div class="bh" data-blackhole>
  <canvas data-bh-canvas aria-hidden="true"></canvas>
  <canvas class="infall" data-bh-infall aria-hidden="true"></canvas>
  <div class="bh-fallback" aria-hidden="true"></div>
</div>

<style>
  .bh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--space);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .infall { pointer-events: none; }
  /* A complete still image while initializing, without JS, or if WebGL is unavailable. */
  .bh-fallback {
    position: absolute;
    inset: 0;
    background: var(--space);
  }
  .bh-fallback::before {
    content: '';
    position: absolute;
    left: 72%;
    top: 45%;
    width: min(74vh, 65vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle,
      #000 0 18%, #bfe3ff 18.5%, #507fbe 19.5%, #131e2c 21%,
      #ffda85 24%, #ef9a35 27%, #763110 31%, #d76a1c 33%,
      #4b1b08 38%, #9d4514 40%, rgba(128, 48, 8, 0.4) 48%, transparent 65%);
  }
  @media (max-width: 860px) {
    .bh-fallback::before { left: 50%; top: 34%; width: min(90vw, 65vh); }
  }
  .bh.is-ready .bh-fallback { display: none; }
  .bh.is-fallback canvas { display: none; }
  .bh.is-fallback .bh-fallback { display: block; }
</style>

<script>
  import { createInfallRenderer } from '../lib/blackHoleInfall';
  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
    #else
      precision mediump float;
    #endif

    uniform vec2  uRes;
    uniform float uTime;
    uniform vec2  uCenter;   // where the hole sits, in height-normalized screen units
    uniform float uZoom;     // focal length
    uniform float uSteps;    // ray-march budget

    const float PI = 3.14159265;
    const float R_IN  = 2.6;   // inner disk edge (Schwarzschild radii)
    const float R_OUT = 9.5;   // outer disk edge
    const float R_BOUND = 13.0;

    float hash21(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }
    vec2 hash22(vec2 p) {
      float n = hash21(p);
      return vec2(n, hash21(p + n + 17.17));
    }
    float vnoise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), u.x),
                 mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), u.x), u.y);
    }
    // Value noise periodic in x with period P, so the disk texture has no seam.
    float pnoise(vec2 p, float P) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      float x0 = mod(i.x, P), x1 = mod(i.x + 1.0, P);
      return mix(mix(hash21(vec2(x0, i.y)), hash21(vec2(x1, i.y)), u.x),
                 mix(hash21(vec2(x0, i.y + 1.0)), hash21(vec2(x1, i.y + 1.0)), u.x), u.y);
    }
    float pfbm(vec2 p, float P, float footprint) {
      float a = 0.5, s = 0.0;
      for (int k = 0; k < 4; k++) {
        // Fade detail below the pixel footprint into its mean. Unfiltered fine octaves
        // and needle-thin ridges sparkle as the disk moves between sample positions.
        float detail = 1.0 - smoothstep(0.4, 1.2, footprint);
        if (detail > 0.0) s += a * mix(0.5, pnoise(p, P), detail);
        else s += a * 0.5;
        p = vec2(p.x * 2.0, p.y * 2.0 + 13.7);
        P *= 2.0;
        footprint *= 2.0;
        a *= 0.5;
      }
      return s;
    }

    vec3 stars(vec3 d) {
      vec2 sph = vec2(atan(d.z, d.x), asin(clamp(d.y, -1.0, 1.0)));
      vec3 col = vec3(0.0);
      // sparse, brighter stars
      {
        vec2 g = sph * 48.0;
        vec2 id = floor(g), f = fract(g);
        vec2 r = hash22(id);
        if (r.x < 0.14) {
          vec2 pos = 0.15 + 0.7 * hash22(id + 7.3);
          float dd = length(f - pos);
          float size = 0.035 + 0.05 * r.y;
          float br = pow(1.0 - smoothstep(0.0, size, dd), 1.6);
          float tw = 0.8 + 0.2 * sin(uTime * (0.8 + 2.5 * r.y) + r.x * 60.0);
          vec3 tint = mix(vec3(0.72, 0.82, 1.0), vec3(1.0, 0.9, 0.72), hash21(id + 3.3));
          col += tint * br * tw * (0.6 + 0.8 * r.y);
        }
      }
      // dense, faint stars
      {
        vec2 g = sph * 130.0;
        vec2 id = floor(g), f = fract(g);
        vec2 r = hash22(id + 99.0);
        if (r.x < 0.22) {
          vec2 pos = 0.2 + 0.6 * hash22(id + 1.9);
          float dd = length(f - pos);
          float br = pow(1.0 - smoothstep(0.0, 0.06, dd), 1.5);
          col += vec3(0.8, 0.86, 1.0) * br * 0.35;
        }
      }
      // Quiet blue-black depth leaves the warm accretion light as the focus.
      float n1 = vnoise(sph * 3.0);
      float n2 = vnoise(sph * 9.0 + 4.2);
      float n3 = vnoise(sph * 20.0 + 9.1);
      col += vec3(0.025, 0.045, 0.075) * (n1 * n1 * n2 * (0.5 + n3)) * 0.08;
      return col;
    }

    // Emission and opacity where a ray crosses the disk plane.
    vec3 diskEmission(vec3 p, vec3 rd, out float alpha) {
      float r = length(p.xz);
      float phi = atan(p.z, p.x);
      // A coherent rotating texture with inward drift. Unbounded differential advection
      // would wind the image into subpixel rings after a minute of viewing.
      float omega = 0.24;
      float ang = phi - omega * uTime;
      float P = 24.0;
      // Periodic polar turbulence: winding filaments, fine braided ridges and dark lanes.
      // Advect the coordinates before warping so the texture flows instead of boiling.
      vec2 q = vec2(ang / (2.0 * PI) * P + log(r) * 7.0, r * 6.4 + uTime * 0.22);
      // An explicit footprint is stable inside the divergent ray-march loop, where
      // screen-space derivatives would be undefined. Include the domain warp's stretch.
      float footprint = 2.0 * 15.0 / (uRes.y * uZoom) * 6.4 * 0.65;
      float warp = pfbm(vec2(q.x, q.y * 0.35), P, footprint * 0.4);
      float eddy = pnoise(vec2(q.x * 2.0, q.y * 1.6), P * 2.0);
      vec2 flow = q + vec2(warp * 2.4, warp * 4.8 + eddy * 0.8);
      float broad = pfbm(flow, P, footprint);
      float fineFootprint = footprint * 2.6;
      float fine = pfbm(vec2(flow.x * 2.0, flow.y * 2.6), P * 2.0, fineFootprint);
      float ridgeDetail = 1.0 - smoothstep(0.7, 1.6, fineFootprint);
      float ridges = mix(0.15, pow(1.0 - abs(2.0 * fine - 1.0), 8.0), ridgeDetail);
      float threads = smoothstep(0.45, 0.78, broad) + ridges * 0.55;
      float lanes = smoothstep(0.24, 0.62, broad);

      float edgeIn = smoothstep(R_IN, R_IN + 0.25, r);
      float edgeOut = 1.0 - smoothstep(R_OUT - 3.5, R_OUT, r + (broad - 0.5) * 0.8);
      float profile = edgeIn * edgeOut * pow(R_IN / r, 1.1);

      float t = clamp((r - R_IN) / (R_OUT - R_IN), 0.0, 1.0);
      vec3 hot  = vec3(1.00, 0.38, 0.045);
      vec3 warm = vec3(1.00, 0.12, 0.003);
      vec3 cool = vec3(0.48, 0.025, 0.001);
      vec3 col = mix(mix(hot, warm, smoothstep(0.0, 0.38, t)), cool, smoothstep(0.35, 1.0, t));
      col = mix(col, vec3(1.0, 0.64, 0.18), clamp(threads - 0.65, 0.0, 0.65) * (1.0 - t));

      // Doppler beaming: the side orbiting toward us is brighter and bluer.
      vec3 tangent = vec3(-p.z, 0.0, p.x) / max(r, 1e-3);
      float v = sqrt(0.5 / r);
      float dop = v * dot(tangent, -rd);
      float beam = pow(clamp(1.0 + dop, 0.3, 2.0), 2.0);
      col = mix(col, col * vec3(0.85, 0.95, 1.2), clamp(dop * 2.5, 0.0, 1.0));

      // The disk is optically thick: moving dark lanes change emission, not the ray's
      // termination point. This avoids sky/haze popping through as turbulence rotates.
      alpha = edgeIn * (1.0 - smoothstep(R_OUT - 3.5, R_OUT, r));
      return col * beam * profile * (0.08 + lanes * 0.65 + threads * threads * 5.0);
    }

    // Camera basis, set once per fragment.
    vec3 gRo, gFw, gRt, gUp;
    vec3 rayDir(vec2 uv) { return normalize(gFw * uZoom + gRt * uv.x + gUp * uv.y); }

    // Linear-light colour seen along one ray.
    // forceCapture: the ray is analytically inside the shadow, so any numeric escape is
    // integration error and is ignored (the disk haze in front of the shadow is kept).
    vec3 trace(vec3 ro, vec3 rd, bool forceCapture) {
      float b = dot(ro, rd);
      float c = dot(ro, ro) - R_BOUND * R_BOUND;
      float h = b * b - c;
      if (h < 0.0) return stars(rd);

      vec3 p = ro + rd * max(-b - sqrt(h), 0.0);
      vec3 v = rd;
      vec3 hv = cross(p, v);
      float h2 = dot(hv, hv);

      vec3 acc = vec3(0.0);
      float accA = 0.0;
      float glow = 0.0;
      bool captured = false;

      for (int i = 0; i < 320; i++) {
        if (float(i) >= uSteps) break;
        float r2 = dot(p, p);
        float r = sqrt(r2);
        if (r < 1.0) { captured = true; break; }
        if (r > R_BOUND && dot(p, v) > 0.0) break;

        float dt = clamp(0.008 + 0.025 * r, 0.03, 0.45);
        // midpoint (RK2) step
        vec3 a = -1.5 * h2 * p / (r2 * r2 * r);
        vec3 pm = p + v * (0.5 * dt);
        vec3 vm = v + a * (0.5 * dt);
        float rm2 = dot(pm, pm);
        vec3 am = -1.5 * h2 * pm / (rm2 * rm2 * sqrt(rm2));
        vec3 vn = v + am * dt;
        vec3 pn = p + vm * dt;

        // thin haze hugging the disk plane
        if (abs(p.y) < 1.5) {
          float rr = length(p.xz);
          glow += dt * exp(-p.y * p.y * 6.0)
                * smoothstep(R_IN - 0.5, R_IN + 1.0, rr)
                * (1.0 - smoothstep(R_OUT - 2.0, R_OUT + 1.0, rr))
                * pow(R_IN / max(rr, R_IN), 2.0);
        }

        // disk crossing between p and pn
        if (p.y * pn.y < 0.0) {
          float f = p.y / (p.y - pn.y);
          vec3 hit = mix(p, pn, f);
          float hr = length(hit.xz);
          if (hr > R_IN && hr < R_OUT) {
            float al;
            vec3 e = diskEmission(hit, normalize(vn), al);
            acc += (1.0 - accA) * e;
            accA += (1.0 - accA) * al;
          }
        }
        p = pn;
        v = vn;
        if (accA > 0.985) break;
      }

      vec3 col = acc;
      if (forceCapture) captured = true;
      if (!captured) {
        col += (1.0 - accA) * stars(normalize(v));
      }
      col += glow * vec3(1.0, 0.42, 0.12) * 0.07;
      return col;
    }

    void main() {
      vec2 uv = (gl_FragCoord.xy * 2.0 - uRes) / uRes.y - uCenter;

      // Almost face-on: the vortex and its dark centre remain legible at every size.
      float elev = 1.50;
      float D = 15.0;
      gRo = vec3(0.0, sin(elev) * D, -cos(elev) * D);
      gFw = normalize(-gRo);
      gRt = normalize(cross(gFw, vec3(0.0, 1.0, 0.0)));
      gUp = cross(gRt, gFw);

      vec3 rd = rayDir(uv);

      // Anti-aliased shadow edge. The shadow is exactly the set of rays whose impact
      // parameter is below B_CRIT, so pixels straddling that circle blend analytically
      // between black and the colour just outside it, instead of snapping to one side.
      const float B_CRIT = 2.598;                 // 3*sqrt(3)/2 Schwarzschild radii
      float bimp = length(cross(gRo, rd));        // impact parameter of this ray
      float px = 2.0 / uRes.y;                    // one pixel, in uv units
      float pxb = px * D / uZoom;                 // one pixel, in impact-parameter units
      float shadowRadius = uZoom * B_CRIT / sqrt(D * D - B_CRIT * B_CRIT);
      float shadowDistance = length(uv) - shadowRadius;
      // Rays with b just above B_CRIT orbit the photon sphere many times, where tiny
      // integration errors can flip them into capture. Pixels in that band are traced
      // at b = B_CRIT + margin (a stable path) and get the photon ring analytically:
      // near the critical radius, rmin - 1.5 ~ sqrt((b - B_CRIT) / 1.2).
      float margin = max(2.0 * pxb, 0.06);
      vec3 col;
      if (bimp > R_OUT + 1.0) {
        // These rays cannot meet the disk; avoid marching through empty space.
        col = stars(rd);
      } else if (bimp <= B_CRIT - 0.6 * pxb) {
        col = vec3(0.0); // analytically captured; the face-on shadow is opaque
      } else if (bimp < B_CRIT + margin) {
        // Blend what this ray sees if captured (disk and haze in front of the hole) with
        // what a ray just outside the edge sees (ring, lensed disk and sky).
        float edge = smoothstep(-0.6 * pxb, 0.6 * pxb, bimp - B_CRIT);
        float bOutside = B_CRIT + margin;
        float radiusOutside = uZoom * bOutside / sqrt(D * D - bOutside * bOutside);
        vec2 uvOut = uv * (radiusOutside / max(length(uv), 1e-4));
        vec3 inside = trace(gRo, rd, true);
        vec3 outside = trace(gRo, rayDir(uvOut), false);
        col = mix(inside, outside, edge);
      } else {
        col = trace(gRo, rd, false);
      }
      if (bimp > R_OUT + 0.3 && bimp < R_OUT + 1.0) {
        col = mix(col, stars(rd), smoothstep(R_OUT + 0.3, R_OUT + 1.0, bimp));
      }

      // One analytic, concentric photon ring. Its width does not depend on capture,
      // disk opacity, camera inclination, or the march budget. Keep the lensed disk
      // from painting an uneven second rim over it.
      float outsideShadow = smoothstep(-0.5 * px, 0.5 * px, shadowDistance);
      float distanceFromEdge = max(0.0, shadowDistance);
      col *= smoothstep(shadowRadius * 0.08, shadowRadius * 0.20, distanceFromEdge);
      float coreWidth = shadowRadius * 0.012;
      float filteredWidth = sqrt(coreWidth * coreWidth + px * px / 6.0);
      float rim = exp(-pow((shadowDistance - coreWidth) / filteredWidth, 2.0)) * coreWidth / filteredWidth;
      float aureole = exp(-distanceFromEdge / (shadowRadius * 0.055));
      col += rim * vec3(0.72, 0.86, 1.0) * 3.0
           + aureole * vec3(0.12, 0.32, 0.80) * 0.85;
      col *= outsideShadow;

      // Hue-preserving exposure keeps copper shadows and gold highlights distinct.
      float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
      vec3 mappedL = col * ((1.0 - exp(-lum * 1.3)) / max(lum, 1e-4));
      vec3 mappedC = 1.0 - exp(-col * 1.3);
      col = mix(mappedL, mappedC, 0.12);
      col = pow(clamp(col, 0.0, 1.0), vec3(1.0 / 2.2));
      col *= clamp(1.0 - 0.25 * dot(uv * 0.6, uv * 0.6), 0.0, 1.0);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const MAX_INTERNAL_WIDTH = 2400;
  const MAX_ANIMATED_PIXELS = 1_100_000;

  function compile(gl: WebGLRenderingContext, type: number, src: string) {
    const sh = gl.createShader(type);
    if (!sh) return null;
    gl.shaderSource(sh, src);
    gl.compileShader(sh);
    if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
      console.error('[blackhole] shader error:', gl.getShaderInfoLog(sh));
      gl.deleteShader(sh);
      return null;
    }
    return sh;
  }

  function start(root: HTMLElement) {
    const canvas = root.querySelector('[data-bh-canvas]') as HTMLCanvasElement;
    const infallCanvas = root.querySelector('[data-bh-infall]') as HTMLCanvasElement;
    const infall = createInfallRenderer(infallCanvas);
    const toggle = document.querySelector<HTMLButtonElement>('[data-bh-toggle]');
    const gl = canvas.getContext('webgl', {
      antialias: false,
      alpha: false,
      depth: false,
      stencil: false,
      powerPreference: 'high-performance',
    }) as WebGLRenderingContext | null;

    const fail = () => {
      root.classList.remove('is-ready');
      root.classList.add('is-fallback');
      if (toggle) toggle.hidden = true;
    };
    if (!gl) return fail();

    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
    const prog = gl.createProgram();
    if (!vs || !fs || !prog) return fail();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      console.error('[blackhole] link error:', gl.getProgramInfoLog(prog));
      return fail();
    }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const u = {
      res: gl.getUniformLocation(prog, 'uRes'),
      time: gl.getUniformLocation(prog, 'uTime'),
      center: gl.getUniformLocation(prog, 'uCenter'),
      zoom: gl.getUniformLocation(prog, 'uZoom'),
      steps: gl.getUniformLocation(prog, 'uSteps'),
    };

    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    const reduced = motionPreference.matches;
    const coarse = matchMedia('(pointer: coarse)').matches;
    let scale = 1.0;
    let motionScale = 1.0;
    // Geometry must not change while the texture moves. Adapt pixel count, not paths.
    const steps = 280;
    // Reduced-motion users get a still frame unless they have pressed Play before.
    let stored: string | null = null;
    try { stored = localStorage.getItem('bh-motion'); } catch { /* storage unavailable */ }
    let playing = stored === 'play' ? true : stored === 'pause' ? false : !reduced;
    let inView = true;
    let time = 18.0;
    let last = 0;
    let raf = 0;
    let ema = 16;
    let slowFrames = 0;
    let lastQualityChange = 0;
    let lost = false;
    let resizeTimer = 0;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const pixelLimit = playing ? MAX_ANIMATED_PIXELS * (coarse ? 0.7 : 1) : 4_000_000;
      const budgetScale = Math.min(1,
        MAX_INTERNAL_WIDTH / Math.max(1, rect.width * dpr),
        Math.sqrt(pixelLimit / Math.max(1, rect.width * rect.height * dpr * dpr)));
      const w = Math.max(1, Math.round(rect.width * dpr * budgetScale * scale));
      const h = Math.max(1, Math.round((w * rect.height) / Math.max(rect.width, 1)));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl!.viewport(0, 0, w, h);
      }
      const aspect = rect.width / Math.max(rect.height, 1);
      // Wide screens: hole right of centre, above the text. Narrow: centred, high.
      const wide = rect.width > 860 && aspect > 1.1;
      const centerX = wide ? aspect * 0.44 : 0.0;
      const centerY = wide ? 0.10 : 0.32;
      const zoom = wide ? Math.min(1.18, aspect * 0.76) : Math.max(0.4, Math.min(0.78, 1.35 * aspect));
      gl!.uniform2f(u.center, centerX, centerY);
      gl!.uniform1f(u.zoom, zoom);
      // Exact projection of b = 2.598 at camera distance 15. Match the analytic shadow,
      // independently of the GPU's adaptive resolution, so the star ribbons stay crisp.
      const horizon = rect.height * 0.5 * zoom * 2.598 / Math.sqrt(15 ** 2 - 2.598 ** 2);
      infall?.resize(rect.width, rect.height,
        rect.width * 0.5 + centerX * rect.height * 0.5,
        rect.height * 0.5 - centerY * rect.height * 0.5, horizon);
    }

    function draw() {
      gl!.uniform2f(u.res, canvas.width, canvas.height);
      gl!.uniform1f(u.time, time);
      gl!.uniform1f(u.steps, steps);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      infall?.draw(time);
    }

    function frame(now: number) {
      raf = 0;
      if (!playing || !inView || document.hidden || lost) return;
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      time += dt;
      // A backing-size change clears WebGL. Resize BEFORE drawing, so no empty frame
      // can reach the compositor. Require sustained slow frames and a cooldown.
      const ms = dt * 1000;
      if (dt > 0) ema = ema * 0.95 + ms * 0.05;
      slowFrames = ema > 20.5 ? slowFrames + 1 : Math.max(0, slowFrames - 1);
      if (slowFrames >= 20 && now - lastQualityChange > 1200 && scale > 0.55) {
        scale = Math.max(0.55, scale * 0.9);
        motionScale = scale;
        lastQualityChange = now;
        slowFrames = 0;
        ema = 16;
        resize();
      }
      draw();
      raf = requestAnimationFrame(frame);
    }

    function wake() {
      if (raf || !playing || !inView || document.hidden || lost) return;
      last = 0;
      raf = requestAnimationFrame(frame);
    }

    function setPlaying(p: boolean) {
      const wasPlaying = playing;
      playing = p;
      if (!p && raf) { cancelAnimationFrame(raf); raf = 0; }
      if (toggle) {
        toggle.setAttribute('aria-pressed', String(!p));
        toggle.textContent = p ? 'Pause' : 'Play';
      }
      if (p !== wasPlaying && !lost) {
        if (!p) motionScale = scale;
        // Restore the learned animation budget on resume instead of stuttering through
        // the same sequence of quality reductions after every full-detail still frame.
        scale = p ? motionScale : 1;
        ema = 16;
        slowFrames = 0;
        resize();
        draw();
      }
      if (p) wake();
    }

    resize();
    draw();
    root.classList.add('is-ready');
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        setPlaying(!playing);
        stored = playing ? 'play' : 'pause';
        try { localStorage.setItem('bh-motion', stored); } catch { /* ignore */ }
      });
    }
    setPlaying(playing);

    // Stretch the current frame during live resizing, then rebuild once settled.
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { if (!lost) { resize(); draw(); } }, 100);
    }).observe(root);
    new IntersectionObserver((entries) => {
      inView = entries[0]?.isIntersecting ?? true;
      if (!inView && raf) { cancelAnimationFrame(raf); raf = 0; }
      if (inView) wake();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && raf) { cancelAnimationFrame(raf); raf = 0; }
      else wake();
    });
    motionPreference.addEventListener('change', (event) => {
      if (stored === null) setPlaying(!event.matches);
    });

    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault(); lost = true;
      if (raf) cancelAnimationFrame(raf);
      raf = 0; fail();
    });
    canvas.addEventListener('webglcontextrestored', () => fail());
  }

  const root = document.querySelector<HTMLElement>('[data-blackhole]');
  if (root) start(root);
</script>
