---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section">
  <h2 class="display">{title}</h2>
  <div class="body"><slot /></div>
</section>

<style>
  .section { scroll-margin-top: var(--header-offset); }
  .section + .section { margin-top: clamp(4rem, 8vw, 6.5rem); }
  h2 {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.82rem;
    color: var(--ink);
    margin-bottom: 1.6rem;
  }
  h2::before {
    content: '';
    width: 1.6rem;
    height: 1px;
    background: var(--accent);
    flex: none;
  }
  .body { max-width: var(--measure); }
</style>
